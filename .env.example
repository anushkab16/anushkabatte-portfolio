# SMTP config for the contact form (app/api/contact/route.ts)
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# For Gmail SMTP: smtp.gmail.com, port 465, and an App Password
# (not your normal Google password — generate one at
# https://myaccount.google.com/apppasswords, requires 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password

# Where contact form submissions get delivered
CONTACT_TO_EMAIL=anushkabatte.work@gmail.com
